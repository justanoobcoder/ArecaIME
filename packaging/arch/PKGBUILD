pkgname=fcitx5-areca
pkgver=0.1.0
pkgrel=1
pkgdesc='Areca Vietnamese input method for Fcitx5'
arch=('x86_64')
url='https://github.com/xhkzeroone/ArecaIME'
license=('MIT')
depends=('fcitx5')
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'go'
  'ninja'
  'pkgconf'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "${srcdir}/${pkgname}-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON \
    -DBUILD_UINPUT_SERVER=ON
  cmake --build build --parallel
}

check() {
  ctest --test-dir build --output-on-failure
  cd "${srcdir}/${pkgname}-${pkgver}/server"
  GOCACHE="${srcdir}/go-test-cache" go test ./...
}

package() {
  DESTDIR="${pkgdir}" cmake --install build --strip
}
